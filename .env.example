PORT=3001
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=attendance
DB_PASSWORD=attendance_dev
DB_NAME=attendance_tracker

# Set true when serving the app over HTTPS.
COOKIE_SECURE=false

# Optional local MariaDB helper (only local attendance_tracker on port 3307).
DB_LOCAL_MANAGED=false

# Optional WhatsApp attendance via your Chatery installation.
CHATERY_URL=http://127.0.0.1:3010
CHATERY_API_KEY=
# Optional absolute path: starts your local Chatery service when connecting.
CHATERY_MANAGED_PATH=

# Optional Keycloak authentication (HTTPS issuer; server-side confidential client).
KEYCLOAK_ISSUER=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
# Exact registered URI, e.g. https://attendance.example.com/api/auth/keycloak/callback
KEYCLOAK_REDIRECT_URI=

# Optional Google Maps Embed API key for location check-in map previews.
# Enable Maps Embed API and restrict this key to your website's HTTP referrers.
GOOGLE_MAPS_EMBED_API_KEY=
# Optional server-side Geocoding API key; also configurable in admin Location tracking.
GOOGLE_MAPS_GEOCODING_API_KEY=
# Optional Geoapify key (maps + area names); select Geoapify in admin Map settings.
GEOAPIFY_API_KEY=
