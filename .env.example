PORT=3001
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=attendance
DB_PASSWORD=attendance_dev
DB_NAME=attendance_tracker

# Set true when serving the app over HTTPS.
COOKIE_SECURE=false

# Optional local MariaDB helper (only local attendance_tracker on port 3307).
DB_LOCAL_MANAGED=false

# Optional WhatsApp attendance via your Chatery installation.
CHATERY_URL=http://127.0.0.1:3010
CHATERY_API_KEY=
# Optional absolute path: starts your local Chatery service when connecting.
CHATERY_MANAGED_PATH=
