+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { EventEmitter } = require('node:events');
+const { historyPage } = require('../src/services/whatsapp/HistoryPage');
+const Store = require('../src/services/whatsapp/BaileysStore');
+const jid = '123@g.us';
+const message = (id, timestamp, content = 'IN 09:00') => ({ key: { id, remoteJid: jid, fromMe: false, participant: '919000000001@s.whatsapp.net' }, messageTimestamp: timestamp, message: { conversation: content } });
+const fixture = () => {
+  const ev = new EventEmitter(); const store = new Store(); store.bind(ev);
+  return { store, socket: { ev }, isGroupId: id => id.endsWith('@g.us') };
+};
+test('asynchronous phone history recovers missed OUT after latest IN; request uses actual key and milliseconds', async () => {
+  const session = fixture(); const latest = message('today-in', 200000);
+  session.socket.ev.emit('messages.upsert', { messages: [latest] });
+  session.socket.fetchMessageHistory = async (count, key, timestamp) => {
+    assert.equal(count, 50); assert.deepEqual(key, latest.key); assert.equal(timestamp, 200000000);
+    setTimeout(() => session.socket.ev.emit('messaging-history.set', { messages: [message('yesterday-out', 150000, 'OUT 18:00')], contacts: [], chats: [{id: jid}], peerDataRequestSessionId: 'request' }), 5);
+    return 'request';
+  };
+  const result = await historyPage(session, jid, 100, null, 100);
+  assert.equal(result.historyPending, false);
+  assert.deepEqual(result.messages.map(m => m.id), ['today-in', 'yesterday-out']);
+  assert.equal(session.socket.ev.listenerCount('messaging-history.set'), 1);
+});
+test('pending phone history remains pending and late delivery is consumed without duplicate request', async () => {
+  const session = fixture(); let requests = 0;
+  session.socket.ev.emit('messages.upsert', { messages: [message('latest', 200000)] });
+  session.socket.fetchMessageHistory = async () => { requests++; return 'pending'; };
+  assert.equal((await historyPage(session, jid, 100, null, 1)).historyPending, true);
+  session.socket.ev.emit('messaging-history.set', { messages: [message('missed', 150000)], peerDataRequestSessionId: 'pending' });
+  const result = await historyPage(session, jid, 100, null, 1);
+  assert.equal(result.historyPending, false); assert.equal(result.messages.length, 2); assert.equal(requests, 1);
+});
+test('filtered protocol messages do not truncate pagination', async () => {
+  const session = fixture();
+  session.socket.ev.emit('messaging-history.set', { messages: [message('old', 1), {...message('protocol', 2), message: null}, message('new', 3)] });
+  const first = await historyPage(session, jid, 2, null);
+  assert.equal(first.messages.length, 1); assert.equal(first.scannedCount, 2); assert.equal(first.hasMore, true); assert.equal(first.cursor, 'protocol');
+  const second = await historyPage(session, jid, 2, first.cursor);
+  assert.deepEqual(second.messages.map(m => m.id), ['old']);
+});
+test('reconnect history updates stored content without emitting live messages', () => {
+  const session = fixture(); let live = 0; session.socket.ev.on('messages.upsert', () => live++);
+  session.socket.ev.emit('messaging-history.set', { messages: [message('recovered', 1)], contacts: [{id:'919000000001@s.whatsapp.net',name:'Employee'}], chats:[{id:jid,name:'Attendance'}] });
+  assert.equal(session.store.getMessages(jid).length, 1); assert.equal(live, 0);
+});
+test('automatic cached reads do not wait for a phone history request', async () => {
+  const session = fixture();
+  session.socket.ev.emit('messages.upsert', { messages: [message('live', 200000)] });
+  session.socket.fetchMessageHistory = async () => { throw new Error('must not request phone'); };
+  const result = await historyPage(session, jid, 100, null, 1, false);
+  assert.equal(result.historyPending, false); assert.equal(result.messages[0].id, 'live');
+});
+test('failed phone requests report the error and clean up listeners', async () => {
+  const session = fixture();
+  session.socket.ev.emit('messages.upsert', { messages: [message('live', 200000)] });
+  session.socket.fetchMessageHistory = async () => { throw new Error('phone unavailable'); };
+  await assert.rejects(historyPage(session, jid, 100, null, 1), /phone unavailable/);
+  assert.equal(session.socket.ev.listenerCount('messaging-history.set'), 1);
+});
+
+test('history cache roundtrip preserves shared messages and identity aliases', () => {
+  const fs = require('node:fs'); const os = require('node:os'); const path = require('node:path');
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'chatery-history-'));
+  try {
+    const store = new Store(); const msg = message('shared-out', 150000, 'OUT 18:00');
+    store.messages.set(jid, new Map([[msg.key.id, msg]]));
+    store.chats.set(jid, {id: jid, messages: [{message: msg}]});
+    store.registerIdentity('12345@lid', '919000000001@s.whatsapp.net');
+    assert.equal(store.writeToFile(path.join(dir, 'store.json')), true);
+    const restored = new Store();
+    assert.equal(restored.readFromFile(path.join(dir, 'store.json')), true);
+    assert.equal(restored.getMessage(jid, 'shared-out').message.conversation, 'OUT 18:00');
+    assert.equal(restored.resolveIdentity('12345@lid').jid, '919000000001@s.whatsapp.net');
+    const saved = JSON.parse(fs.readFileSync(path.join(dir, 'store.json'), 'utf8'));
+    assert.ok(saved.lidMap.every(([, value]) => value !== null));
+    const cycle = {}; cycle.self = cycle;
+    assert.equal(store._safeSerialize(cycle), '{}');
+  } finally { fs.rmSync(dir, {recursive:true,force:true}); }
+});
