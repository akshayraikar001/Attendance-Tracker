@@ -0,0 +1,74 @@
+const MessageFormatter = require('./MessageFormatter');
+const requests = new WeakMap();
+
+async function recoverHistory(socket, jid, anchor, count, waitMs = 6000) {
+  if (!anchor || typeof socket.fetchMessageHistory !== 'function') return false;
+  let cache = requests.get(socket);
+  if (!cache) requests.set(socket, cache = new Map());
+  const key = `${jid}:${anchor.key.id}:${count}`;
+  const now = Date.now();
+  for (const [id, item] of cache) if (item.expires <= now) { item.cancel(); cache.delete(id); }
+  let item = cache.get(key);
+  if (!item) {
+    item = { done: false, expires: now + 120000 };
+    let resolve;
+    item.promise = new Promise(r => { resolve = r; });
+    let timer;
+    const finish = (complete) => {
+      socket.ev.off('messaging-history.set', onHistory);
+      clearTimeout(timer);
+      item.done = complete;
+      item.expires = Date.now() + (complete ? 60000 : 0);
+      resolve();
+    };
+    const onHistory = data => {
+      // Match the request where supported; otherwise match only this chat.
+      const matches = data.peerDataRequestSessionId && item.requestId
+        ? data.peerDataRequestSessionId === item.requestId
+        : data.messages?.some(m => m.key?.remoteJid === jid) || data.chats?.some(c => c.id === jid);
+      if (matches) finish(true);
+    };
+    item.cancel = () => finish(false);
+    cache.set(key, item);
+    socket.ev.on('messaging-history.set', onHistory);
+    timer = setTimeout(item.cancel, 120000);
+    timer.unref?.();
+    try {
+      // Returns a request ID. Messages arrive asynchronously through the store.
+      item.requestId = await socket.fetchMessageHistory(count, anchor.key, Number(anchor.messageTimestamp) * 1000);
+    } catch (error) {
+      item.cancel();
+      cache.delete(key);
+      throw error;
+    }
+  }
+  if (!item.done) {
+    let timer;
+    await Promise.race([item.promise, new Promise(resolve => { timer = setTimeout(resolve, waitMs); })]);
+    clearTimeout(timer);
+  }
+  return !item.done;
+}
+
+async function historyPage(session, jid, limit, cursor, waitMs, recover = true) {
+  limit = Math.min(50, Math.max(1, Number(limit) || 50));
+  const store = session.store;
+  if (!store) throw new Error('WhatsApp message store is not ready. Try syncing again.');
+  const anchor = cursor ? store.getMessage(jid, cursor) : store.getMessages(jid, { limit: 1 })[0];
+  if (cursor && !anchor) throw new Error('WhatsApp history cursor is unavailable. Restart the history scan.');
+  const historyPending = recover ? await recoverHistory(session.socket, jid, anchor, limit, waitMs) : false;
+  // Pagination follows raw messages, including protocol messages the formatter omits.
+  const raw = store.getMessages(jid, { limit, before: cursor });
+  return {
+    chatId: jid,
+    isGroup: session.isGroupId(jid),
+    total: raw.length,
+    scannedCount: raw.length,
+    limit,
+    cursor: raw.at(-1)?.key.id || null,
+    hasMore: raw.length === limit,
+    historyPending,
+    messages: raw.map(m => MessageFormatter.formatMessage(m, store)).filter(Boolean),
+  };
+}
+module.exports = { historyPage };
